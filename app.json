{
  "expo": {
    "name": "LifeMate",
    "slug": "lifemate",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "scheme": "lifemate",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "vn.mobifone.vnsteel",
      "googleServicesFile": "./firebase/GoogleService-Info.plist",
      "entitlements": {
        "aps-environment": "development"
      },
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification", "audio"],
        "ITSAppUsesNonExemptEncryption": false,
        "NSCalendarsUsageDescription": "LifeMate dùng lịch khi bạn chọn thêm công việc vào lịch thiết bị.",
        "NSCalendarsFullAccessUsageDescription": "LifeMate dùng lịch khi bạn chọn thêm công việc vào lịch thiết bị.",
        "NSRemindersUsageDescription": "LifeMate dùng lời nhắc khi bạn chọn quản lý lời nhắc trong lịch thiết bị.",
        "NSRemindersFullAccessUsageDescription": "LifeMate dùng lời nhắc khi bạn chọn quản lý lời nhắc trong lịch thiết bị."
      }
    },
    "android": {
      "package": "vn.mobifone.vnsteel",
      "googleServicesFile": "./firebase/google-services.json",
      "permissions": ["android.permission.POST_NOTIFICATIONS"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#F7FAFC"
      }
    },
    "plugins": [
      [
        "@react-native-firebase/app",
        {
          "ios": {
            "disableSPM": true
          }
        }
      ],
      "@react-native-firebase/auth",
      "@react-native-firebase/messaging",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "buildReactNativeFromSource": true,
            "forceStaticLinking": [
              "RNFBApp",
              "RNFBAuth",
              "RNFBRemoteConfig",
              "RNFBMessaging",
              "RNFBAnalytics",
              "RNFBStorage",
              "RNFBFirestore"
            ]
          }
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "lifemate",
          "color": "#9C701D",
          "icon": "./assets/notification-icon.png"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7FAFC",
          "image": "./assets/icon.png",
          "imageWidth": 160
        }
      ],
      "expo-font",
      [
        "@react-native-firebase/analytics",
        {
          "ios": {
            "withoutAdIdSupport": true
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": true
        }
      ],
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "LifeMate cần truy cập album để bạn chọn video và tách âm thanh.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "LifeMate dùng Face ID để bảo vệ sổ thu chi của bạn."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "LifeMate dùng Face ID để bảo vệ sổ thu chi của bạn."
        }
      ]
    ]
  }
}
